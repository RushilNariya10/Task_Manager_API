    {
      "name": "07. GET /tasks (All Tasks - 200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is an array of tasks\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(Array.isArray(jsonData)).to.be.true;",
              "    pm.expect(jsonData.length).to.eql(2);",
              "    pm.expect(jsonData[0].title).to.eql('Learn Express');",
              "    pm.expect(jsonData[1].title).to.eql('Build REST API');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/tasks",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "tasks"
          ]
        },
        "description": "Step 7: Returns all tasks (status 200 OK)"
      },
      "response": []
    },
