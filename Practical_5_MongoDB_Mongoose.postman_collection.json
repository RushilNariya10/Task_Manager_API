  "item": [
    {
      "name": "1. POST /tasks (Create Task - 201 Created)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Response has generated _id and correct schema fields\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('_id');",
              "    pm.expect(jsonData.title).to.eql('Complete MongoDB Practical');",
              "    pm.expect(jsonData.description).to.eql('Implement CRUD operations using Mongoose');",
              "    pm.expect(jsonData.completed).to.be.false;",
              "    pm.expect(jsonData).to.have.property('createdAt');",
              "    pm.collectionVariables.set('task_id', jsonData._id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Complete MongoDB Practical\",\n  \"description\": \"Implement CRUD operations using Mongoose\",\n  \"completed\": false\n}"
        },
        "url": {
          "raw": "{{base_url}}/tasks",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "tasks"
          ]
        },
        "description": "Creates a new Task document in MongoDB via Mongoose Task.create(). Expects 201 Created."
      },
      "response": []
    },
    {
